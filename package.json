{
  "name": "blog",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "serve": "vite preview",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md,mdx}\""
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 140
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "p5": "^2.3.4",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@prefresh/vite": "^4.0.1",
    "@types/node": "^26.6.3",
    "@webgpu/types": "^0.1.74",
    "lowlight": "3.3.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "yaml": "^2.9.1"
  }
}
