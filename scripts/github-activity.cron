# Rebuild all default-branch history daily; keep the last JSON on failure.
17 3 * * * root /usr/bin/flock -n /run/blog-activity.lock /usr/bin/python3 /opt/blog-activity/update_github_activity.py --token-file /etc/blog-activity/github-token --output /srv/blog-activity/activity.json >> /var/log/blog-activity.log 2>&1
